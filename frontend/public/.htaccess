# Served by Apache for the SPA's public/ directory on both environments.
# Ships with the frontend build (vite copies public/ into dist/).

RewriteEngine On

# Existing files and directories are served as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else is a client-side route -> index.html
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Vite emits content-hashed js/css under /assets — safe to cache for a year.
  <FilesMatch "\.(js|css|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The entry page must always be re-validated so a deploy takes effect.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
