{
  "name": "frontend",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --config vite.config.test.ts --port 5174 --host",
    "build": "tsc --noEmit && vite build",
    "build:test": "NODE_ENV=test tsc --noEmit && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:run": "vitest run",
    "test:components": "vitest run src/components/**/*.test.{ts,tsx}",
    "test:services": "vitest run src/services/**/*.test.{ts,tsx}",
    "test:contexts": "vitest run src/contexts/**/*.test.{ts,tsx}",
    "test:portals": "vitest run src/components/portals/**/*.test.{ts,tsx}"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@mui/x-date-pickers": "^6.20.2",
    "@tanstack/react-query": "^5.80.7",
    "axios": "^1.20.0",
    "country-flag-icons": "^1.6.17",
    "date-fns": "^2.30.0",
    "dompurify": "^3.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-phone-number-input": "^3.4.12",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "audit-ci": "^7.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.5.3",
    "snyk": "^1.1299.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.28.1"
  }
}
