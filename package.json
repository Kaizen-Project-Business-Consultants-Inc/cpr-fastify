{
  "name": "cpr-jun132026-dev",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "test": "npm run test -w backend && npm run test:run -w frontend",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "typecheck": "npx -w backend tsc --noEmit && npx -w frontend tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "concurrently": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0"
  },
  "lint-staged": {
    "backend/src/**/*.ts": "npx -w backend eslint --fix",
    "frontend/**/*.{ts,tsx}": "npx -w frontend eslint --fix"
  }
}
